@{
    ViewData["Title"] = "Dashboard";
    Layout = null; /* Cambia esto si usas _Layout.cshtml */
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Dashboard</title>
    <link rel="stylesheet" href="~/Content/dashboard.css" />
</head>
<body>

    <!-- NAVBAR SUPERIOR -->
    <header class="navbar">
        <div class="logo">
            Nombre de la aplicación
        </div>

        <nav class="menu">
            <a href="@Url.Action("Index","Dashboard")">Dashboard</a>
            <a href="@Url.Action("Index","Employees")">Empleados</a>
            <a href="@Url.Action("Index","Departments")">Departamentos</a>
            <a href="@Url.Action("Index","DeptEmps")">Asignación Depto.</a>
            <a href="@Url.Action("Index","DeptManagers")">Gerentes Depto.</a>
            <a href="@Url.Action("Index","Titles")">Títulos</a>
            <a href="@Url.Action("Index","Salaries")">Salarios</a>
            <a href="@Url.Action("Index","LogAuditoriaSalarios")">Auditoría</a>
            <a href="@Url.Action("Logout","Account")" class="logout">Cerrar Sesión</a>
        </nav>
    </header>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="content">
        <h1>Bienvenido al Sistema de Nómina</h1>

        <div class="cards">

            <div class="card">
                <h3>Empleados</h3>
                <p>Gestión de empleados registrados.</p>
            </div>

            <div class="card">
                <h3>Departamentos</h3>
                <p>Administrar departamentos.</p>
            </div>

            <div class="card">
                <h3>Salarios</h3>
                <p>Control de pagos y sueldos.</p>
            </div>

            <div class="card">
                <h3>Auditoría</h3>
                <p>Registro de actividades del sistema.</p>
            </div>

        </div>
    </main>

</body>
</html>