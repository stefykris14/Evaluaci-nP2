@{
    ViewBag.Title = "Empleados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Content/Employees.css" />

<div class="empleados-container">

    <h1 class="titulo">Gestión de Empleados</h1>
    <p class="subtitulo">Resumen general del personal y sus departamentos</p>

    <!-- TARJETAS RESUMEN -->
    <div class="cards-resumen">

        <div class="card total">
            <h3>Total Empleados</h3>
            <p>45</p>
        </div>

        <div class="card sistemas">
            <h3>Sistemas</h3>
            <p>15</p>
        </div>

        <div class="card finanzas">
            <h3>Finanzas</h3>
            <p>12</p>
        </div>

        <div class="card rrhh">
            <h3>Recursos Humanos</h3>
            <p>8</p>
        </div>

        <div class="card ventas">
            <h3>Ventas</h3>
            <p>10</p>
        </div>

    </div>

    <!-- BOTONES -->
    <div class="acciones">

        <button class="btn agregar">Agregar Empleado</button>
        <button class="btn editar">Editar</button>
        <button class="btn eliminar">Eliminar</button>

    </div>

    <!-- TABLA -->
    <div class="tabla-contenedor">

        <table class="tabla-empleados">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Departamento</th>
                    <th>Cargo</th>
                </tr>
            </thead>

            <tbody>

                <tr>
                    <td>1</td>
                    <td>Juan</td>
                    <td>Pérez</td>
                    <td>Sistemas</td>
                    <td>Programador</td>
                </tr>

                <tr>
                    <td>2</td>
                    <td>María</td>
                    <td>López</td>
                    <td>Finanzas</td>
                    <td>Contadora</td>
                </tr>

                <tr>
                    <td>3</td>
                    <td>Carlos</td>
                    <td>Torres</td>
                    <td>Ventas</td>
                    <td>Supervisor</td>
                </tr>

                <tr>
                    <td>4</td>
                    <td>Ana</td>
                    <td>Morales</td>
                    <td>Recursos Humanos</td>
                    <td>Analista</td>
                </tr>

            </tbody>

        </table>

    </div>

</div>