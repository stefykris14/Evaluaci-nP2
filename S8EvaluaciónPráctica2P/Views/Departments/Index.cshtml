@{
    ViewData["Title"] = "Departamentos";
    Layout = null; /* Independiente igual que tu Dashboard */
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Departamentos</title>
    <link rel="stylesheet" href="~/Content/Departments.css" />
</head>
<body>

    <!-- NAVBAR SUPERIOR -->
    <header class="navbar">
        <div class="logo">
            Nombre de la aplicación
        </div>

        <nav class="menu">
            <a href="@Url.Action("Index","Dashboard")">Dashboard</a>
            <a href="@Url.Action("Index","Employees")">Empleados</a>
            <a href="@Url.Action("Index","Departments")">Departamentos</a>
            <a href="@Url.Action("Index","DeptEmps")">Asignación Depto.</a>
            <a href="@Url.Action("Index","DeptManagers")">Gerentes Depto.</a>
            <a href="@Url.Action("Index","Titles")">Títulos</a>
            <a href="@Url.Action("Index","Salaries")">Salarios</a>
            <a href="@Url.Action("Index","LogAuditoriaSalarios")">Auditoría</a>
            <a href="@Url.Action("Logout","Account")" class="logout">Cerrar Sesión</a>
        </nav>
    </header>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="content">
        <h1>Gestión de Departamentos</h1>

        <button class="btn-crear" disabled>+ Nuevo Departamento</button>

        <div class="cards">

            <div class="card">
                <h3>Recursos Humanos</h3>
                <p>Gestión del talento y bienestar laboral.</p>
                <span>12 empleados</span>

                <div class="actions">
                    <button disabled>Editar</button>
                    <button disabled>Eliminar</button>
                </div>
            </div>

            <div class="card">
                <h3>Finanzas</h3>
                <p>Administración contable y financiera.</p>
                <span>8 empleados</span>

                <div class="actions">
                    <button disabled>Editar</button>
                    <button disabled>Eliminar</button>
                </div>
            </div>

            <div class="card">
                <h3>Tecnología</h3>
                <p>Desarrollo y soporte técnico.</p>
                <span>15 empleados</span>

                <div class="actions">
                    <button disabled>Editar</button>
                    <button disabled>Eliminar</button>
                </div>
            </div>

            <div class="card">
                <h3>Marketing</h3>
                <p>Estrategias comerciales y publicidad.</p>
                <span>6 empleados</span>

                <div class="actions">
                    <button disabled>Editar</button>
                    <button disabled>Eliminar</button>
                </div>
            </div>

        </div>
    </main>

</body>
</html>